{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "*",
        "bash": "/opt/agent-guard/bin/agent-guard pretool",
        "powershell": "/opt/agent-guard/bin/agent-guard pretool",
        "timeoutSec": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "mcp__agent_guard__write_file",
        "bash": "/opt/agent-guard/bin/agent-guard check post-edit",
        "powershell": "/opt/agent-guard/bin/agent-guard check post-edit",
        "timeoutSec": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "/opt/agent-guard/bin/agent-guard check stop",
        "timeoutSec": 600
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "bash": "/opt/agent-guard/bin/agent-guard preflight",
        "timeoutSec": 5
      }
    ]
  }
}
