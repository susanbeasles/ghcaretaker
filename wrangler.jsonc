{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghcaretaker",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://mcp.vespoli.me",
    "MCP_PATH": "/ghcaretaker",
    "GITHUB_OWNER": "susanbeasles",
    "GITHUB_OWNER_ID": "215839550"
  },
  "r2_buckets": [
    {
      "binding": "AUDIT_BUCKET",
      "bucket_name": "ghcaretaker-audit"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "ghcaretaker-audit",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "mcp.vespoli.me/ghcaretaker*",
      "zone_name": "vespoli.me"
    },
    {
      "pattern": "mcp.vespoli.me/.well-known/oauth-protected-resource/ghcaretaker*",
      "zone_name": "vespoli.me"
    },
    {
      "pattern": "mcp.vespoli.me/.well-known/oauth-authorization-server/ghcaretaker/auth*",
      "zone_name": "vespoli.me"
    }
  ],
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_VAULT",
        "class_name": "AppVault"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AppVault"
      ]
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ]
}
