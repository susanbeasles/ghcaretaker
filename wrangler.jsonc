{
  "name": "ghcaretaker",
  "account_id": "1a799c6e699d2ef7e87398692ce3ad7b",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "GITHUB_OWNER": "susanbeasles",
    "GITHUB_OWNER_ID": "215839550",
    "MCP_PATH": "/ghcaretaker",
    "PUBLIC_ORIGIN": "https://mcp.vespoli.me",
    "AUTH_ORIGIN": "https://control.vespoli.me",
    "HOOKS_ORIGIN": "https://hooks.vespoli.me",
    "CARETAKER_APP_ID": ""
  },
  "r2_buckets": [
    {
      "binding": "AUDIT_BUCKET",
      "bucket_name": "ghcaretaker-audit"
    },
    {
      "binding": "EVENTS",
      "bucket_name": "github-events"
    }
  ],
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "ghcaretaker-audit",
      "database_id": "02b01e07-fea9-4ee3-8801-fde7a7d14199",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_VAULT",
        "class_name": "AppVault"
      },
      {
        "name": "EVENT_LEDGER",
        "class_name": "EventLedger"
      },
      {
        "name": "COMMIT_LEDGER",
        "class_name": "CommitLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AppVault"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "EventLedger",
        "CommitLedger"
      ]
    }
  ],
  "triggers": {
    "crons": []
  },
  "services": [
    {
      "binding": "AUTH_GATEWAY",
      "service": "personal-control"
    },
    {
      "binding": "BACKUP",
      "service": "backup",
      "entrypoint": "BackupIngest"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_WEBHOOK_SECRET",
      "store_id": "b6504fe2d5f64352954629bc7185fb79",
      "secret_name": "GITHUB_WEBHOOK_SECRET"
    },
    {
      "binding": "GITHUB_WEBHOOK_SECRET_PREVIOUS",
      "store_id": "b6504fe2d5f64352954629bc7185fb79",
      "secret_name": "GITHUB_WEBHOOK_SECRET_PREVIOUS"
    },
    {
      "binding": "CARETAKER_APP_KEY",
      "store_id": "b6504fe2d5f64352954629bc7185fb79",
      "secret_name": "CARETAKER_APP_KEY"
    },
    {
      "binding": "ALERT_WEBHOOK_URL",
      "store_id": "b6504fe2d5f64352954629bc7185fb79",
      "secret_name": "ALERT_WEBHOOK_URL"
    }
  ],
  "routes": [
    {
      "pattern": "mcp.vespoli.me/ghcaretaker*",
      "zone_name": "vespoli.me"
    },
    {
      "pattern": "mcp.vespoli.me/.well-known/oauth-protected-resource/ghcaretaker*",
      "zone_name": "vespoli.me"
    },
    {
      "pattern": "mcp.vespoli.me/.well-known/oauth-authorization-server/ghcaretaker/auth*",
      "zone_name": "vespoli.me"
    },
    {
      "pattern": "hooks.vespoli.me/github",
      "zone_name": "vespoli.me"
    }
  ]
}
