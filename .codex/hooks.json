{
  "description": "agent-guard: ingress scanning (guard.py) and action supervision (supervisor.py) for Codex. Review and trust with /hooks after cloning.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-guard/bin/agent-guard pretool",
            "timeout": 15,
            "statusMessage": "agent-guard: policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__agent_guard__write_file",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-guard/bin/agent-guard check post-edit",
            "timeout": 15,
            "statusMessage": "agent-guard: output scan"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-guard/bin/agent-guard preflight",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-guard/bin/agent-guard check stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
