{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)",
      "Bash(sudo:*)",
      "Bash(chflags:*)",
      "Bash(launchctl:*)",
      "Bash(osascript:*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/git/**)",
      "Read(~/.aws/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./node_modules/**)",
      "Read(./vendor/**)",
      "Read(./.git/**)",
      "Write(./.agent-guard/**)",
      "Edit(./.agent-guard/**)",
      "Write(./.claude/**)",
      "Edit(./.claude/**)",
      "Write(./.github/workflows/**)",
      "Edit(./.github/workflows/**)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-guard/bin/agent-guard pretool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__agent_guard__write_file",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-guard/bin/agent-guard check post-edit",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-guard/bin/agent-guard preflight",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agent-guard/bin/agent-guard check stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
